# D-ID API pipeline for caddie video generation.
# Copy these into .env.local (which IS gitignored — your real values
# never leave your machine). The script scripts/generate-caddie.ts
# reads these via --env-file=.env.local at runtime.

# ── REQUIRED ─────────────────────────────────────────────────────────
# D-ID dashboard → API Keys → copy the key
D_ID_API_KEY=your_did_api_key_here

# ── OPTIONAL per caddie ──────────────────────────────────────────────
# D-ID Studio → Presenters → click your custom Kevin → copy presenter_id.
# When unset, the script falls back to a STOCK source_url (Alice) so
# you can validate the pipeline end-to-end before wiring real presenters.
# Output video will obviously not look like the caddie until you set this.
# D_ID_KEVIN_PRESENTER_ID=
# D_ID_SERENA_PRESENTER_ID=
# D_ID_TANK_PRESENTER_ID=
# D_ID_HARRY_PRESENTER_ID=

# ── OPTIONAL voice routing ───────────────────────────────────────────
# ElevenLabs voice id per caddie. When set, D-ID routes TTS through
# ElevenLabs with this voice id so the pre-rendered video matches the
# in-app /api/voice TTS voice. When unset, D-ID uses Microsoft Azure
# en-US-GuyNeural as the default voice.
# D_ID_KEVIN_VOICE_ID=1fz2mW1imKTf5Ryjk5su
# D_ID_SERENA_VOICE_ID=RGb96Dcl0k5eVje8EBch
# D_ID_TANK_VOICE_ID=gQOVuaEi4cxS2vkZAK3A
# D_ID_HARRY_VOICE_ID=5Jfxy1x2Df4No3LQBZXE

# ── OWNER MODE (app, not the D-ID pipeline) ──────────────────────────
# EXPO_PUBLIC_OWNER_EMAIL unlocks Owner Tools and grants `lifetime`
# (bypassing the trial) on the build it is baked into.
#
# READ THIS BEFORE SETTING IT. app/_layout.tsx line ~689 computes
#   isOwner: isOwnerEmail(profileEmail) || (EXPO_PUBLIC_OWNER_EMAIL ?? '').trim().length > 0
# so ANY non-empty value makes the build an owner build — it does not have
# to match, or even be, a real email. It marks the ARTIFACT, not the person.
# Hand such a build to a tester and that tester gets Owner Tools and a
# lifetime grant.
#
# WHY IT IS LEFT COMMENTED: copying this file to .env.local should not
# silently turn owner mode on. Uncomment it deliberately.
#
# WHERE IT MATTERS:
#   • eas.json already sets it on the `development` and `preview` build
#     profiles, and deliberately NOT on production / production-apk /
#     glasses — a test asserts that, so a release build can never carry it.
#   • .env.local is what an OTA needs. EXPO_PUBLIC_* is inlined into the JS
#     bundle at EXPORT time, and `npm run ota:preview` runs `eas update`,
#     which exports here. Without this line the published bundle ships with
#     no owner email and Owner Tools disappears from the preview build that
#     had it — the JS replaces what the binary was built with.
# EXPO_PUBLIC_OWNER_EMAIL=t.gustafson75@gmail.com
