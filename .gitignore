# know which env vars the D-ID pipeline + app need. Real values live in
# the gitignored .env.local.
!.env.example

# typescript
*.tsbuildinfo

app-example

# generated native folders
/ios
/android
.expo-tunnel-qr.png

# Python
__pycache__/
*.pyc
*.pyo
.venv/
.vercel

# 2026-05-22 — iOS signing credentials. .p12 + .mobileprovision + credentials.json
# all contain secrets. EAS reads these locally at build time; they are NOT
# uploaded to git. Each developer needs their own copy on disk.
credentials/
credentials.json
*.p12
*.mobileprovision
*.p8

# 2026-05-27 — marketing voiceover fallback output dir. Generator
# (scripts/generate-vo.mjs) writes mp3s to ~/Desktop by default; falls
# back to ./vo-output/ if Desktop isn't writable. Either way, never
# commit the generated audio.
vo-output/
SmartPlay_VO_*.mp3

# 2026-05-27 — Claude Code session worktrees. These are agent-scratch
# git repos nested inside this project; never track them as content or
# submodule references in the parent.
.claude/worktrees/

# 2026-09-04 — Cowork <-> Claude Code shared scratch channel. Local only;
# never committed, never deployed, never read by the app at runtime.
#
# No trailing slash, deliberately. "_handoff/" would match the DIRECTORY only, and a symlink
# named _handoff is a file — it would not be ignored, and `git add -A` would commit it. That
# is exactly how node_modules got committed as a self-symlink on 2026-09-03 and destroyed
# itself on every checkout for two sessions.
_handoff
