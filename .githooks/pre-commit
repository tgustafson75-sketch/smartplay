#!/bin/sh
# SmartPlay Caddie — typecheck gate (added 2026-08-20)
#
# WHY THIS EXISTS: the standing delivery workflow is ts-check + jest + sim + commit + push, but it
# was enforced only by remembering to do it. On 2026-08-20 a commit ran as
#     npx tsc --noEmit | head -3 ; npx jest ; git commit
# and the `;` meant the commit did not care that tsc had failed. `tsx` and `jest` do not typecheck,
# so sim (777) and jest (1083) both stayed green over a real type error and it reached main AND the
# remote. Discipline is not a gate. This is.
#
# Scope is tsc only — 8s, cheap enough to pay on every commit. jest (~90s) and the simulation suite
# stay manual so this hook never becomes something worth bypassing out of impatience.
#
# Genuine emergency: git commit --no-verify

if git diff --cached --name-only | grep -qE '\.(ts|tsx)$'; then
  printf 'pre-commit: typechecking... '
  if OUT=$(npx tsc --noEmit 2>&1); then
    printf 'clean\n'
  else
    printf 'FAILED\n\n%s\n\n' "$OUT"
    echo 'Commit blocked: fix the type errors above, or --no-verify if this is a genuine emergency.'
    exit 1
  fi

  # 2026-08-21 — JEST JOINS THE GATE. This hook was typecheck-only, and on 08-21 a genuinely
  # failing test was committed and pushed because tsc was clean: a flaky throughput assertion that
  # passed alone and failed in a full parallel run. The whole reason this hook exists is that
  # discipline is not a gate, and "I'll run the tests after" is discipline.
  #
  # Measured at ~7s for the full suite, which is cheap enough to pay on every commit. The
  # simulation suites stay manual — they are slower, and this must never become worth bypassing.
  printf 'pre-commit: running tests... '
  if OUT=$(npx jest --silent 2>&1); then
    printf 'clean\n'
  else
    printf 'FAILED\n\n%s\n\n' "$(echo "$OUT" | tail -40)"
    echo 'Commit blocked: fix the failing tests above, or --no-verify if this is a genuine emergency.'
    exit 1
  fi
fi
